# ───────────────────────────────────────────────────────────────
# Phase 0 quickstart config — copy to `.env` and adjust as needed.
#   cp .env.example .env
#
# These are LOCAL DEV credentials only. Never reuse in any real env.
# ───────────────────────────────────────────────────────────────

# MinIO root creds == the S3 access/secret key every service uses.
# MinIO requires the secret to be at least 8 characters.
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=password
AWS_REGION=us-east-1

# Iceberg warehouse bucket created on startup.
LAKEHOUSE_BUCKET=warehouse

# Phase 3 (services overlay): Superset session signing key. Dev-only default.
SUPERSET_SECRET_KEY=odp-dev-secret-change-me
