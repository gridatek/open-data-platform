# ───────────────────────────────────────────────────────────────
# Open Data Platform — monorepo .gitignore
# Covers: Java/Spring Boot, Angular/Node, Python, Helm/K8s, Docker
# ───────────────────────────────────────────────────────────────

# ── OS ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE / editors ──────────────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.swp
*.swo
*~

# ── Logs & temp ────────────────────────────────────────────────
*.log
*.tmp
*.pid
*.seed
tmp/
temp/

# ── Secrets / local env (NEVER commit) ─────────────────────────
.env
.env.*
!.env.example
*.local
*.pem
*.key
*.p12
*.keystore
secrets/
**/credentials.json

# ───────────────────────────────────────────────────────────────
# console/api — Java / Spring Boot (Maven & Gradle)
# ───────────────────────────────────────────────────────────────
target/
build/
!**/src/**/build/
.gradle/
out/
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar
!**/maven-wrapper.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# ───────────────────────────────────────────────────────────────
# console/web — Angular / Node
# ───────────────────────────────────────────────────────────────
node_modules/
dist/
.angular/
.nx/cache/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ───────────────────────────────────────────────────────────────
# labs / ml — Python (Spark jobs, notebooks, JupyterHub)
# ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ───────────────────────────────────────────────────────────────
# platform — Helm / Kubernetes
# ───────────────────────────────────────────────────────────────
**/charts/*.tgz
**/Chart.lock
**/*.orig
# local kubeconfigs / contexts
kubeconfig
*.kubeconfig

# ───────────────────────────────────────────────────────────────
# quickstart — Docker / data volumes
# ───────────────────────────────────────────────────────────────
docker-compose.override.yml
# local MinIO / lakehouse data, sample datasets generated locally
# (scoped to quickstart so platform/warehouse source dir is NOT ignored)
quickstart/data/
quickstart/volumes/
quickstart/warehouse/
.minio/
