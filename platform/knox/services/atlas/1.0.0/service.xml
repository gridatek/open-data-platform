<!-- ATLAS: reverse-proxy passthrough to the in-network backend. APIs and SQL
     proxy cleanly; UI-heavy backends may need response rewrite rules added. -->
<service role="ATLAS" name="atlas" version="1.0.0">
    <metadata>
        <type>UI</type>
        <context>/atlas/</context>
        <shortDesc>Atlas metadata and lineage</shortDesc>
        <description>Atlas metadata and lineage</description>
    </metadata>
    <routes>
        <route path="/atlas/**?**">
            <rewrite apply="ATLAS/atlas/inbound" to="request.url"/>
        </route>
    </routes>
</service>
